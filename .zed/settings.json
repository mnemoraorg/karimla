{
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/.jj",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    "**/__pycache__/**",
    "**/node_modules/**",
    "**/.venv/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/.wrangler/**",
    "**/.expo/**",
    "**/dist/**",
    "**/.vinext/**",
  ],
  "languages": {
    "Java": {
      "format_on_save": "on",
      "formatter": "language_server",
    },
  },
}
