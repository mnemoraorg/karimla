# Application
PORT=35081
ENVIRONMENT=development

# (Postgres) Relational Database
DATABASE_URL=""

# BetterAuth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""
# Required in production so the web and auth hosts share the session cookie (e.g. mnemora.org).
BETTER_AUTH_COOKIE_DOMAIN=""

# CORS
# The web origin allowed to call the auth service, comma-separated for more
# than one. Production must name the deployed web app.
CORS_ALLOWED_ORIGINS="http://localhost:35000"

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""

# Cloudflare Email Delivery
NO_REPLY_EMAIL=""
