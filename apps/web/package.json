{
  "name": "web",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.14",
  "scripts": {
    "generate-types": "wrangler types --env-interface=CloudflareEnv ./worker-configuration.d.ts",
    "test": "bun test",
    "dev": "bun run generate-types && vinext dev --port 35000",
    "build": "bun run generate-types && vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "deploy": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "deploy:cloudflare": "vinext build && vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@packages/metadata": "workspace:*",
    "@packages/ui-w": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "5.102.8",
    "@thesvg/react": "^3.3.13",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "vinext": "1.0.0-beta.9",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.7",
    "@packages/typescript": "workspace:*",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitejs/plugin-rsc": "0.5.34",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.131.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
